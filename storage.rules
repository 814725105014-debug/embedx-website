rules_version = '2';

// EMBEDX Storage rules — images only; uploads for owner + staff roles that edit visual sections.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
             && (request.auth.token.email == '814725105014@trp.srmtrichy.edu.in'
                 || request.auth.token.admin == true);
    }
    function hasRole() {
      return signedIn()
             && exists(/databases/$(firestore)/documents/admin_roles/$(request.auth.token.email));
    }
    function legacyPerms(r) {
      return r == 'president'         ? ['announcements', 'team', 'achievements', 'tasks']
        :    r == 'event_coordinator' ? ['events']
        :    r == 'social_media'      ? ['gallery', 'announcements']
        :    r == 'technical'         ? ['projects', 'resources', 'achievements']
        :    [];
    }
    function permsOf() {
      return get(/databases/$(firestore)/documents/admin_roles/$(request.auth.token.email)).data.perms != null
        ? get(/databases/$(firestore)/documents/admin_roles/$(request.auth.token.email)).data.perms
        : legacyPerms(get(/databases/$(firestore)/documents/admin_roles/$(request.auth.token.email)).data.role);
    }
    // upload allowed when the admin can edit at least one visual section
    function canUpload() {
      return isOwner()
        || (hasRole() && ('gallery' in permsOf() || 'events' in permsOf() || 'team' in permsOf()
                          || 'projects' in permsOf() || 'achievements' in permsOf()));
    }
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if canUpload()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
