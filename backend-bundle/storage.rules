rules_version = '2';

// EMBEDX Storage rules — images only, admin upload/replace, public read.
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
             && request.auth.token.email == '814725105014@trp.srmtrichy.edu.in';
    }
    function isAdmin() {
      return (request.auth != null && request.auth.token.admin == true) || isOwner();
    }
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
