rules_version = '2';

// EMBEDX Storage rules — public images, uploads scoped to the matching CMS section.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
             && (request.auth.token.email == '814725105014@trp.srmtrichy.edu.in'
                 || request.auth.token.admin == true);
    }
    function rolePath() {
      return /databases/$(firestore)/documents/admin_roles/$(request.auth.token.email);
    }
    function hasRole() { return signedIn() && exists(rolePath()); }
    function legacyPerms(r) {
      return r == 'president'         ? ['announcements', 'team', 'achievements', 'tasks']
        :    r == 'event_coordinator' ? ['events']
        :    r == 'social_media'      ? ['gallery', 'announcements']
        :    r == 'technical'         ? ['projects', 'resources', 'achievements']
        :    [];
    }
    function permsOf() {
      return get(rolePath()).data.perms != null
        ? get(rolePath()).data.perms
        : legacyPerms(get(rolePath()).data.role);
    }
    function canEdit(section) {
      return isOwner() || (hasRole() && section in permsOf());
    }
    function isAllowedSection(section) {
      return section in ['events', 'projects', 'team', 'gallery', 'achievements'];
    }
    function validImageUpload() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    match /images/{section}/{imagePath=**} {
      allow read: if true;
      allow write: if isAllowedSection(section) && canEdit(section) && validImageUpload();
    }
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
