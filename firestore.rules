rules_version = '2';

// EMBEDX Firestore security rules.
//  • Public read: events, projects, team, gallery, announcements, resources, achievements.
//  • Portal write: Firebase Auth + role from `admin_roles/{email}` (or legacy admin claim / owner email).
//  • Roles: owner (all), president, hod (read-only), event_coordinator, social_media, technical.
//  • Create-only with strict validation: members_applications, contact_messages.
//  • Everything else denied.
//
// Bootstrap owner (allowlisted so the portal works from day one):
//   814725105014@trp.srmtrichy.edu.in
// Extra logins: portal "Admins & roles" page, scripts/create-admin.js, or the create-admin GitHub Action.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStr(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }
    function isIsoDate(field) {
      return field is string && field.size() >= 20 && field.size() <= 40;
    }
    function isEmail(field) {
      return field is string && field.size() >= 5 && field.size() <= 120
             && field.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
             && (request.auth.token.email == '814725105014@trp.srmtrichy.edu.in'
                 || request.auth.token.admin == true);
    }
    function rolePath() { return /databases/$(database)/documents/admin_roles/$(request.auth.token.email); }
    function hasRole() { return signedIn() && exists(rolePath()); }
    function myRole() { return get(rolePath()).data.role; }
    function isStaff() { return isOwner() || hasRole(); }

    // per-admin custom permissions: owner ticks sections in the portal (admin_roles/{email}.perms).
    // Docs created before custom perms fall back to their role preset.
    function legacyPerms(r) {
      return r == 'president'         ? ['announcements', 'team', 'achievements', 'tasks']
        :    r == 'event_coordinator' ? ['events']
        :    r == 'social_media'      ? ['gallery', 'announcements']
        :    r == 'technical'         ? ['projects', 'resources', 'achievements']
        :    [];
    }
    function permsOf() {
      return get(rolePath()).data.perms != null ? get(rolePath()).data.perms : legacyPerms(get(rolePath()).data.role);
    }
    function canWrite(sec) { return isOwner() || (hasRole() && sec in permsOf()); }

    // ---- content collections: public read, role-scoped write ----
    match /events/{id}        { allow read: if true; allow create, update, delete: if canWrite('events'); }
    match /projects/{id}      { allow read: if true; allow create, update, delete: if canWrite('projects'); }
    match /team/{id}          { allow read: if true; allow create, update, delete: if canWrite('team'); }
    match /gallery/{id}       { allow read: if true; allow create, update, delete: if canWrite('gallery'); }
    match /announcements/{id} { allow read: if true; allow create, update, delete: if canWrite('announcements'); }
    match /resources/{id}     { allow read: if true; allow create, update, delete: if canWrite('resources'); }
    match /achievements/{id}  { allow read: if true; allow create, update, delete: if canWrite('achievements'); }

    // ---- portal roles: staff can read the directory, only owner manages it ----
    // (exception: a user may clear their own "must change password" flag after choosing a new one)
    match /admin_roles/{email} {
      allow read: if isStaff();
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (signedIn()
            && resource.id == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
            && request.resource.data.mustChangePassword == false);
    }

    // ---- tasks: staff read; owner/president manage; assignees may flip their own status ----
    match /tasks/{id} {
      allow read: if isStaff();
      allow create, delete: if canWrite('tasks');
      allow update: if canWrite('tasks')
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['open', 'in_progress', 'done']
            && (request.auth.token.email == resource.data.assigneeEmail
                || (hasRole() && resource.data.assigneeRole == myRole())));
    }

    // ---- club membership applications: create-only ----
    match /members_applications/{applicationId} {
      allow read: if false;
      allow update: if false;
      allow delete: if false;
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'regNo', 'department', 'year', 'interest', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'regNo', 'department', 'year', 'interest', 'message', 'createdAt'])
        && isStr(request.resource.data.name, 2, 80)
        && isEmail(request.resource.data.email)
        && isStr(request.resource.data.regNo, 0, 40)
        && isStr(request.resource.data.department, 2, 120)
        && isStr(request.resource.data.year, 0, 40)
        && isStr(request.resource.data.interest, 3, 300)
        && isStr(request.resource.data.message, 0, 2000)
        && isIsoDate(request.resource.data.createdAt);
    }

    // ---- contact form messages: create-only ----
    match /contact_messages/{messageId} {
      allow read: if false;
      allow update: if false;
      allow delete: if false;
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt'])
        && isStr(request.resource.data.name, 2, 80)
        && isEmail(request.resource.data.email)
        && isStr(request.resource.data.subject, 0, 160)
        && isStr(request.resource.data.message, 3, 2000)
        && isIsoDate(request.resource.data.createdAt);
    }

    // ---- deny everything else ----
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
