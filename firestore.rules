rules_version = '2';

// EMBEDX Firestore security rules.
//  • Public read: events, projects, team, gallery, announcements, resources, achievements.
//  • Portal write: Firebase Auth + role from `admin_roles/{email}` (or legacy admin claim / owner email).
//  • Roles: owner (all), president, hod (read-only), event_coordinator, social_media, technical.
//  • Create-only with strict validation: members_applications, contact_messages.
//  • Gallery admins can queue constrained bundled-image deletion requests for a reviewed GitHub PR.
//  • Everything else denied.
//
// Bootstrap owner (allowlisted so the portal works from day one):
//   814725105014@trp.srmtrichy.edu.in
// Extra logins: portal "Admins & roles" page, scripts/create-admin.js, or the create-admin GitHub Action.
service cloud.firestore {
  match /databases/{database}/documents {

    function isStr(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }
    function isIsoDate(field) {
      return field is string && field.size() >= 20 && field.size() <= 40;
    }
    function isEmail(field) {
      return field is string && field.size() >= 5 && field.size() <= 120
             && field.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
             && (request.auth.token.email == '814725105014@trp.srmtrichy.edu.in'
                 || request.auth.token.admin == true);
    }
    function rolePath() { return /databases/$(database)/documents/admin_roles/$(request.auth.token.email); }
    function hasRole() { return signedIn() && exists(rolePath()); }
    function roleNeedsEmailVerification() {
      let roleData = get(rolePath()).data;
      return ('emailVerificationRequired' in roleData) && roleData.emailVerificationRequired == true;
    }
    function verifiedRole() {
      return hasRole() && (!roleNeedsEmailVerification() || request.auth.token.email_verified == true);
    }
    function myRole() { return get(rolePath()).data.role; }
    function isOpenForm(formId) {
      let formRef = /databases/$(database)/documents/forms/$(formId);
      return exists(formRef) && get(formRef).data.status == 'open';
    }

    // per-admin custom permissions: owner ticks sections in the portal (admin_roles/{email}.perms).
    // Docs created before custom perms fall back to their role preset.
    function legacyPerms(r) {
      return r == 'president'         ? ['announcements', 'team', 'achievements', 'forms', 'tasks']
        :    r == 'event_coordinator' ? ['events']
        :    r == 'social_media'      ? ['gallery', 'announcements']
        :    r == 'technical'         ? ['projects', 'resources', 'achievements']
        :    [];
    }
    function permsOf() {
      return get(rolePath()).data.perms != null ? get(rolePath()).data.perms : legacyPerms(get(rolePath()).data.role);
    }
    function canWrite(sec) { return isOwner() || (verifiedRole() && sec in permsOf()); }
    function isTaskAssignee(task) {
      return signedIn() && request.auth.token.email_verified == true
        && (task.assigneeEmail == request.auth.token.email
            || (verifiedRole() && task.assigneeRole == myRole()));
    }

    // ---- content collections: public read, role-scoped write ----
    match /events/{id}        { allow read: if true; allow create, update, delete: if canWrite('events'); }
    match /projects/{id}      { allow read: if true; allow create, update, delete: if canWrite('projects'); }
    match /team/{id}          { allow read: if true; allow create, update, delete: if canWrite('team'); }
    match /gallery/{id}       { allow read: if true; allow create, update, delete: if canWrite('gallery'); }
    match /announcements/{id} { allow read: if true; allow create, update, delete: if canWrite('announcements'); }
    match /resources/{id}     { allow read: if true; allow create, update, delete: if canWrite('resources'); }
    match /achievements/{id}  { allow read: if true; allow create, update, delete: if canWrite('achievements'); }

    // ---- portal roles: owner manages the directory; users read their own role; task managers resolve role assignments ----
    // (exception: a user may clear their own password/verification flags after completing those steps)
    match /admin_roles/{email} {
      allow read: if isOwner()
        || (signedIn() && request.auth.token.email == email)
        || canWrite('tasks');
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (signedIn()
            && resource.id == request.auth.token.email
            && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
                 && request.resource.data.mustChangePassword == false)
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerificationRequired'])
                    && request.resource.data.emailVerificationRequired == false
                    && request.auth.token.email_verified == true)
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt'])
                    && request.resource.data.lastLoginAt == request.time)
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
                    && request.resource.data.lastActiveAt == request.time)));
    }

    // ---- permanent content deletion markers: prevent automatic starter sync from resurrecting deletes ----
    match /content_tombstones/{tombstoneId} {
      allow read: if isOwner()
        || (signedIn()
            && resource.data.section in ['announcements', 'events', 'projects', 'team', 'gallery', 'resources', 'achievements', 'forms']
            && canWrite(resource.data.section));
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['section', 'contentId', 'deletedBy', 'deletedAt'])
        && request.resource.data.keys().hasOnly(['section', 'contentId', 'deletedBy', 'deletedAt'])
        && request.resource.data.section in ['announcements', 'events', 'projects', 'team', 'gallery', 'resources', 'achievements', 'forms']
        && isStr(request.resource.data.contentId, 1, 150)
        && request.resource.data.deletedBy == request.auth.token.email
        && request.resource.data.deletedAt == request.time
        && canWrite(request.resource.data.section);
      allow update, delete: if false;
    }

    // ---- tasks: task managers read/manage all; assignees see only their own tasks ----
    match /tasks/{id} {
      allow read: if canWrite('tasks') || isTaskAssignee(resource.data);
      allow create, delete: if canWrite('tasks');
      allow update: if canWrite('tasks')
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['open', 'in_progress', 'done']
            && isTaskAssignee(resource.data));
    }

    // ---- gallery asset deletion requests: public GitHub credentials are never used ----
    // Gallery admins may queue a static asset removal. A trusted GitHub Action validates
    // references and opens a pull request; only the Admin SDK updates request status.
    match /asset_delete_requests/{requestId} {
      allow read: if canWrite('gallery');
      allow create: if canWrite('gallery')
        && request.resource.data.keys().hasAll(['galleryId', 'imageUrl', 'requestedBy', 'requestedAt'])
        && request.resource.data.keys().hasOnly(['galleryId', 'imageUrl', 'requestedBy', 'requestedAt'])
        && isStr(request.resource.data.galleryId, 1, 150)
        && isStr(request.resource.data.imageUrl, 20, 240)
        && request.resource.data.imageUrl.matches('^/assets/images/[A-Za-z0-9][A-Za-z0-9._-]*\\.(webp|png|jpe?g|gif|svg)$')
        && request.resource.data.requestedBy == request.auth.token.email
        && request.resource.data.requestedAt == request.time;
      allow update, delete: if false;
    }

    // ---- owner-managed forms and public responses ----
    match /forms/{formId} {
      allow read: if true;
      allow create, update, delete: if canWrite('forms');
    }

    match /page_content/{pageId} {
      allow read: if true;
      allow create, update: if canWrite('site')
        && request.resource.data.keys().hasOnly(['navHome', 'navAbout', 'navDomains', 'navProjects', 'navEvents', 'navAchievers', 'navTeam', 'navResources', 'navContact', 'navJoin', 'footerNavHeading', 'footerHome', 'footerAbout', 'footerDomains', 'footerProjects', 'footerEvents', 'footerAchievers', 'footerCommunityHeading', 'footerTeam', 'footerResources', 'footerJoin', 'footerContact', 'footerEventRegistration', 'footerConnectHeading', 'footerConnectDescription', 'footerTagline', 'footerCopyright', 'heroEyebrow', 'heroTitle', 'heroDescription', 'heroTechline', 'aboutTitle', 'aboutDescription', 'communityTitle', 'communityDescription', 'journeyTitle', 'projectsEyebrow', 'projectsTitle', 'projectsDescription', 'achieversEyebrow', 'achieversTitle', 'achieversDescription', 'eventsEyebrow', 'eventsTitle', 'eventsDescription', 'eyebrow', 'title', 'intro', 'overviewTitle', 'overviewDescription', 'missionTitle', 'visionTitle', 'journeyEyebrow', 'journeyDescription', 'toolsEyebrow', 'toolsTitle', 'toolsDescription', 'careersEyebrow', 'careersTitle', 'eligibilityTitle', 'eligibilityDescription', 'processTitle', 'departmentHeading', 'addressLabel', 'address', 'socialHeading', 'blocks', 'updatedAt'])
        && (!('blocks' in request.resource.data) || (request.resource.data.blocks is list && request.resource.data.blocks.size() <= 50));
      allow delete: if false;
    }

    match /site_links/{linkId} {
      allow read: if true;
      allow create, update: if linkId == 'links' && canWrite('site')
        && request.resource.data.keys().hasAll(['primary', 'headerJoin', 'footerNavigation', 'footerCommunity', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['primary', 'headerJoin', 'footerNavigation', 'footerCommunity', 'updatedAt'])
        && request.resource.data.primary is list && request.resource.data.primary.size() <= 25
        && request.resource.data.headerJoin is list && request.resource.data.headerJoin.size() <= 5
        && request.resource.data.footerNavigation is list && request.resource.data.footerNavigation.size() <= 25
        && request.resource.data.footerCommunity is list && request.resource.data.footerCommunity.size() <= 25
        && isIsoDate(request.resource.data.updatedAt);
      allow delete: if false;
    }

    match /site_settings/{settingId} {
      allow read: if settingId == 'site' || canWrite('forms');
      allow create, update: if (settingId == 'site' && canWrite('site'))
        || (settingId == 'forms' && isOwner());
      allow delete: if false;
    }
    match /form_responses/{responseId} {
      allow read, update, delete: if canWrite('forms');
      allow create: if
        request.resource.data.keys().hasAll(['formId', 'formTitle', 'answers', 'submittedAt'])
        && request.resource.data.keys().hasOnly(['formId', 'formTitle', 'answers', 'submittedAt'])
        && isStr(request.resource.data.formId, 1, 120)
        && isStr(request.resource.data.formTitle, 1, 160)
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 30
        && isIsoDate(request.resource.data.submittedAt)
        && isOpenForm(request.resource.data.formId);
    }

    // ---- club membership applications: public create, admin monitor/delete ----
    match /members_applications/{applicationId} {
      allow read: if canWrite('forms');
      allow update: if false;
      allow delete: if canWrite('forms');
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'regNo', 'department', 'year', 'interest', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'regNo', 'department', 'year', 'interest', 'message', 'createdAt', 'formId'])
        && (!('formId' in request.resource.data) || (isStr(request.resource.data.formId, 1, 120) && isOpenForm(request.resource.data.formId)))
        && isStr(request.resource.data.name, 2, 80)
        && isEmail(request.resource.data.email)
        && isStr(request.resource.data.regNo, 0, 40)
        && isStr(request.resource.data.department, 2, 120)
        && isStr(request.resource.data.year, 0, 40)
        && isStr(request.resource.data.interest, 3, 300)
        && isStr(request.resource.data.message, 0, 2000)
        && isIsoDate(request.resource.data.createdAt);
    }

    // ---- contact form messages: public create, admin monitor/delete ----
    match /contact_messages/{messageId} {
      allow read: if canWrite('forms');
      allow update: if false;
      allow delete: if canWrite('forms');
      allow create: if
        request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'createdAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'createdAt', 'formId'])
        && (!('formId' in request.resource.data) || (isStr(request.resource.data.formId, 1, 120) && isOpenForm(request.resource.data.formId)))
        && isStr(request.resource.data.name, 2, 80)
        && isEmail(request.resource.data.email)
        && isStr(request.resource.data.subject, 0, 160)
        && isStr(request.resource.data.message, 3, 2000)
        && isIsoDate(request.resource.data.createdAt);
    }

    // ---- deny everything else ----
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
